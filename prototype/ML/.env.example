SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Direct Postgres connection string — needed for automatic table creation
# Find it in: Supabase Dashboard → Project Settings → Database → Connection String → URI (Session mode, port 5432)
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
