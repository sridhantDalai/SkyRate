# ==============================================================================
# SkyRate - Docker Environment Variables Template
# Copy this file to .env before running: docker compose up --build
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports & Networking
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
API_ENV=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Credentials
# (Required for live data persistence; leave empty for offline demo mock mode)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional Admin Secret for protected endpoints (cache clearing)
ADMIN_SECRET=
