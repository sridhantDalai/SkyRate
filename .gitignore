# ==============================================================================
# SkyRate - Root Git Ignore
# ==============================================================================

# Environment files & Secrets (Strictly Excluded)
.env
.env.*
.env*.local
!.env.example
!**/.env.example
!.env.docker.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Pytest / Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Node / Next.js
node_modules/
.next/
out/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
*.tsbuildinfo
next-env.d.ts

# Operating System & IDEs
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
